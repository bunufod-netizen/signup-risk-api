# Comma-separated origins. Leave unset to disable browser cross-origin access.
CORS_ORIGINS=
DNS_TIMEOUT_SECONDS=3
DNS_RETRIES=1
MAX_BULK_EMAILS=100
MAX_REQUEST_BODY_BYTES=32768
# Set this to the X-RapidAPI-Proxy-Secret value from RapidAPI to require gateway access.
RAPIDAPI_PROXY_SECRET=
PORT=8000
LOG_LEVEL=INFO
